# Copy this file to .env.local and fill in your own Supabase project's
# values (Project Settings -> API in the Supabase dashboard).
#
# Both of these are meant to be public/client-visible by Supabase's design
# — real protection comes from Row Level Security policies in the
# database (see supabase/migrations/), not from hiding this key.
#
# Never put the "service_role" key here or anywhere in this app's code —
# that one IS secret and must never be client-visible.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
