# Copy this file to .env.local and fill in your own values.
#
# --- Supabase (Project Settings -> API in the Supabase dashboard) ---
#
# Both of these are meant to be public/client-visible by Supabase's design
# — real protection comes from Row Level Security policies in the
# database (see supabase/migrations/), not from hiding this key.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service_role" key, from the same Project Settings -> API page.
# Unlike the two above, this one IS secret — it bypasses Row Level
# Security entirely. It deliberately has NO "NEXT_PUBLIC_" prefix, which
# is what keeps Next.js from ever sending it to the browser; it's used
# only inside src/app/api/consultations/[id]/room (Phase 9), and only
# after that route has already confirmed the caller's own access rights
# via their own token. Never rename this to add a NEXT_PUBLIC_ prefix,
# and never reference it from any "use client" file.
SUPABASE_SERVICE_ROLE_KEY=

# --- Daily.co (Phase 9 — audio/video calls) ---
# From your Daily.co dashboard -> Developers. Also secret, also
# deliberately without a NEXT_PUBLIC_ prefix, for the same reason above.
DAILY_API_KEY=
