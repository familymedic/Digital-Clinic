# Copy this file to .env.local and fill in your own values.
#
# --- Supabase (Project Settings -> API in the Supabase dashboard) ---
#
# Both of these are meant to be public/client-visible by Supabase's design
# — real protection comes from Row Level Security policies in the
# database (see supabase/migrations/), not from hiding this key.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service_role" key, from the same Project Settings -> API page.
# Unlike the two above, this one IS secret — it bypasses Row Level
# Security entirely. It deliberately has NO "NEXT_PUBLIC_" prefix, which
# is what keeps Next.js from ever sending it to the browser; it's used
# only inside src/app/api/consultations/[id]/room (Phase 9), and only
# after that route has already confirmed the caller's own access rights
# via their own token. Never rename this to add a NEXT_PUBLIC_ prefix,
# and never reference it from any "use client" file.
SUPABASE_SERVICE_ROLE_KEY=

# --- Daily.co (Phase 9 — audio/video calls) ---
# From your Daily.co dashboard -> Developers. Also secret, also
# deliberately without a NEXT_PUBLIC_ prefix, for the same reason above.
DAILY_API_KEY=

# --- Safepay (Phase 10 — the PKR 500 consultation payment) ---
# From your Safepay dashboard, under Developer -> API. Start with the
# SANDBOX dashboard/keys (sandbox.api.getsafepay.com) to test before any
# real bank account is involved — see the physician's payment-gateway
# research doc for how to sign up. All three are secret, server-only.
#
# The merchant API key (starts with "sec_").
SAFEPAY_API_KEY=
# From Safepay's dashboard under Developer -> Endpoints, once a webhook
# endpoint is registered there pointing at
# https://<your-deployed-domain>/api/payments/webhook — this is what
# lets the app verify a payment notification really came from Safepay
# and wasn't forged, so it must be set correctly before going live.
SAFEPAY_WEBHOOK_SECRET=
# "sandbox" while testing, "production" only once ready to take real
# payments from real patients.
SAFEPAY_ENVIRONMENT=sandbox
